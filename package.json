{
  "name": "scipris",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "api:generate": "node scripts/generate-core-api.mjs",
    "api:lint": "redocly lint --extends=spec docs/api/core-v3.openapi.yaml",
    "start": "ng serve",
    "nlp:serve": "node scripts/nlp/server.mjs",
    "serve:production": "node scripts/hosting/server.mjs",
    "build": "ng build --configuration production",
    "test": "npm run test:hosting && npm run test:nlp && ng test --watch=false",
    "test:hosting": "node --test scripts/hosting/*.test.mjs",
    "test:nlp": "node --test scripts/nlp/*.test.mjs",
    "test:api": "ng test --watch=false --include='src/app/core/api/**/*.spec.ts'"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "echarts": "6.1.0",
    "jose": "6.2.18",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@redocly/cli": "2.82.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
